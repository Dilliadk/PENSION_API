				</textElement>
				<textFieldExpression><![CDATA["निजले" + ($P{is_current_fy}? " चालु ": " ") + "आर्थिक वर्ष "+ $P{fy} + " मा प्राप्त " + ($P{is_current_fy}? "गर्नुहुने" : "गर्नुभएको") + " रकमको विवरण नेपाली रुपैयाँ (NPR) तथा नेपाल राष्ट्र बैंकको आधिकारिक विनिमय दर (१ " + $P{currency_code} + " = रु. " + $P{currency_rate} + " का अनुसार) बमोजिम निम्न अनुसार " + ($P{is_current_fy}? "हुनेछ" : "रहेको छ") + ":"]]></textFieldExpression>
