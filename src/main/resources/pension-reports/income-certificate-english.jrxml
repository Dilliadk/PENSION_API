				<textFieldExpression><![CDATA["This is to certify that " 
+ "<b>" + $P{pensioner_name} + "</b>" 
+ " (Pension Patta No. " + "<b>" + $P{pension_subpno} + "</b>" 
+") having retired from the " + $P{type_name}+ " service of the Government of Nepal, is a pensioner receiving a regular pension through this office." 
+ "<br/><br/>" + 
"The details of the amount " + ($P{is_current_fy}? "to be " : "") + "received by the individual annually, converted into " + $P{currency_code} + " based on Nepal Rastra Bank exchange rate (Exchange Rate: 1 " + $P{currency_code} + " = NPR " + $P{currency_rate} + ") " + ($P{is_current_fy}? "are" : "were") + " as follows:"]]></textFieldExpression>
			</textField>
